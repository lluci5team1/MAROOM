SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=replace_with_supabase_password

# Railway currently uses these shorter aliases. Either set these or the SPRING_* names above.
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:6543/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=replace_with_supabase_password

SERPAPI_API_KEY=replace_with_serpapi_key
SERPAPI_BASE_URL=https://serpapi.com/search.json

VOYAGE_API_KEY=replace_with_voyage_key
MAROOM_EMBEDDINGS_ENABLED=true

SPRING_DATASOURCE_MAX_POOL_SIZE=5
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
PORT=8080


#./mvnw spring-boot:run
